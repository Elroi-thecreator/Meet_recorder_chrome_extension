{
  "manifest_version": 3,
  "name": "Meet Screen & Audio Recorder",
  "version": "1.0.0",
  "description": "Long-form Meet recorder with background streaming and IndexedDB buffering.",
  "permissions": [
    "tabCapture",
    "activeTab",
    "storage",
    "unlimitedStorage",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}