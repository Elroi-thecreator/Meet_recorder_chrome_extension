{
  "manifest_version": 3,
  "name": "Meet Screen & Audio Recorder Pro",
  "version": "1.4.0",
  "description": "Studio-grade Google Meet recorder with 48kHz DSP audio chain, pause/resume, and auto-naming.",
  "permissions": [
    "tabCapture",
    "activeTab",
    "storage",
    "unlimitedStorage",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}